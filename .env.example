# ============================================================
# RoadSense AI — Environment Variables Example
# Copy this file to frontend/.env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ---- Next.js / Frontend ------------------------------------
NEXT_PUBLIC_APP_NAME="RoadSense AI"

# In production on Vercel, set this to /api/v1 (serverless handles it)
# In local development, the Next.js rewrite proxy handles /api/v1 → localhost:8000
NEXT_PUBLIC_API_URL="/api/v1"

# Map defaults (New Delhi, India)
NEXT_PUBLIC_MAP_DEFAULT_LAT=28.6139
NEXT_PUBLIC_MAP_DEFAULT_LNG=77.2090
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=13

# ---- NextAuth ----------------------------------------------
# Generate with: openssl rand -base64 32  (or any 32+ char random string)
NEXTAUTH_SECRET="your-random-nextauth-secret-min-32-characters"

# Set to your Vercel deployment URL in production (no trailing slash)
# Leave empty or remove in production — NextAuth auto-detects on Vercel
NEXTAUTH_URL="http://localhost:3000"

# ---- Backend / FastAPI -------------------------------------
# PostgreSQL connection string (Neon free tier recommended)
# Format: postgresql+asyncpg://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/roadsense?sslmode=require"

# JWT secret for FastAPI token signing — must match NEXTAUTH_SECRET or be its own value
JWT_SECRET_KEY="your-jwt-secret-key-min-32-characters"

# ---- Cloudinary (Free tier — file uploads in production) ---
# Sign up at https://cloudinary.com (free: 25 GB storage, 25 GB bandwidth/month)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ---- CORS --------------------------------------------------
# Your Vercel frontend URL — required so the Python backend allows requests from it
FRONTEND_URL="https://your-project.vercel.app"

# Comma-separated list of allowed origins (optional — defaults to localhost:3000)
# BACKEND_CORS_ORIGINS="http://localhost:3000,https://your-project.vercel.app"
